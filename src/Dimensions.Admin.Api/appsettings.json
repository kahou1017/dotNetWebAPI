{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DimensionsDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Dimensions",
    "Audience": "DimensionsClients",
    "SecretKey": "Dimensions-Development-Secret-Key-For-Skeleton",
    "DefaultExpireDays": 30,
    "AllowPermanentToken": true
  },
  "Cors": {
    "AllowedOrigins": [
      "*"
    ]
  },
  "System": {
    "EnvironmentName": "Development",
    "SystemCode": "Dimensions"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionStringName": "DefaultConnection",
    "CommandTimeoutSeconds": 30
  }
}
