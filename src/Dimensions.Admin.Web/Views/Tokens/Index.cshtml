@model TokenIndexPageModel

<section class="surface-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2>Token 清單</h2>
            <div class="muted-text">可依條件查詢目前已建立的 token。</div>
        </div>
        <a class="btn btn-dark" asp-action="Create">建立 Token</a>
    </div>

    <form method="get" class="filter-grid">
        <div>
            <label class="form-label">TokenType</label>
            <input name="TokenType" value="@Model.Filter.TokenType" class="form-control" />
        </div>
        <div>
            <label class="form-label">UserId</label>
            <input name="UserId" value="@Model.Filter.UserId" class="form-control" />
        </div>
        <div>
            <label class="form-label">Status</label>
            <input name="Status" value="@Model.Filter.Status" class="form-control" />
        </div>
        <div>
            <label class="form-label">PageSize</label>
            <input name="PageSize" value="@Model.Filter.PageSize" class="form-control" />
        </div>
        <div class="d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">查詢</button>
        </div>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        <div>@Model.ErrorMessage</div>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
        {
            <div class="small">ErrorCode: @Model.ErrorCode</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.CaseId))
        {
            <div class="case-chip">caseId: @Model.CaseId</div>
        }
    </div>
}

<section class="surface-card">
    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>TokenId</th>
                    <th>類型</th>
                    <th>名稱</th>
                    <th>User</th>
                    <th>Scope</th>
                    <th>狀態</th>
                    <th>LastUsedAt</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Result?.Items?.Any() == true)
            {
                foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td><code>@item.TokenId</code></td>
                        <td>@item.TokenType</td>
                        <td>@item.TokenName</td>
                        <td>@item.UserName<br /><span class="muted-text">@item.UserId</span></td>
                        <td>@item.Scope</td>
                        <td>
                            <span class="status-badge @(item.Status == "Active" ? "status-badge--active" : "status-badge--danger")">@item.Status</span>
                        </td>
                        <td>@item.LastUsedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a class="btn btn-sm btn-outline-dark" asp-action="Detail" asp-route-tokenId="@item.TokenId">查看</a></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center muted-text py-4">目前查無符合條件的 token。</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
