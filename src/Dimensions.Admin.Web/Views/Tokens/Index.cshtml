@model TokenIndexPageModel

<partial name="_SearchPanel" model='new SearchPanelModel
{
    Title = "Token 清單",
    Description = "在這裡查詢已建立的 token，快速查看使用者、範圍與目前狀態。",
    FieldsPartialName = "Tokens/_TokenFilters",
    FieldsModel = Model,
    ResetUrl = Url.Action("Index"),
    SubmitText = "查詢"
}' />

<partial name="_ErrorAlert" model='new ErrorAlertModel { Title = "查詢 Token 失敗", ErrorMessage = Model.ErrorMessage, ErrorCode = Model.ErrorCode, CaseId = Model.CaseId }' />

<div class="action-bar">
    <a class="btn btn-dark" asp-action="Create">建立 Token</a>
</div>

<partial name="_DataTable" model='new DataTableModel
{
    HasItems = Model.Result?.Items?.Any() == true,
    TablePartialName = "Tokens/_TokenTable",
    TableModel = Model,
    EmptyMessage = "目前查無符合條件的 token。"
}' />
