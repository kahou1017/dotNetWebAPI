@model TokenCreatePageModel

<section class="surface-card">
    <h2>建立 Token</h2>
    <p class="muted-text">建立新的業務 token，可設定 scope、有效期限，以及是否保留裝置綁定欄位。</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <div>@Model.ErrorMessage</div>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorCode))
            {
                <div class="small">ErrorCode: @Model.ErrorCode</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CaseId))
            {
                <div class="case-chip">caseId: @Model.CaseId</div>
            }
        </div>
    }

    <form asp-action="Create" method="post" class="d-flex flex-column gap-3">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div>
                <label asp-for="TokenType" class="form-label"></label>
                <select asp-for="TokenType" class="form-select">
                    <option>UserAccess</option>
                    <option>Integration</option>
                    <option>Service</option>
                </select>
            </div>
            <div>
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
            </div>
            <div>
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" />
            </div>
            <div>
                <label asp-for="TokenName" class="form-label"></label>
                <input asp-for="TokenName" class="form-control" />
            </div>
            <div>
                <label asp-for="Scope" class="form-label"></label>
                <input asp-for="Scope" class="form-control" />
            </div>
            <div>
                <label asp-for="Purpose" class="form-label"></label>
                <input asp-for="Purpose" class="form-control" />
            </div>
            <div>
                <label asp-for="EffectiveAt" class="form-label"></label>
                <input asp-for="EffectiveAt" type="datetime-local" value="@Model.EffectiveAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div>
                <label asp-for="ExpireAt" class="form-label"></label>
                <input asp-for="ExpireAt" type="datetime-local" value="@Model.ExpireAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
            </div>
            <div>
                <label asp-for="DeviceId" class="form-label"></label>
                <input asp-for="DeviceId" class="form-control" />
            </div>
            <div>
                <label asp-for="DeviceName" class="form-label"></label>
                <input asp-for="DeviceName" class="form-control" />
            </div>
        </div>

        <div>
            <label asp-for="Remark" class="form-label"></label>
            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <input asp-for="IsSingleDevice" class="form-check-input" />
                <label asp-for="IsSingleDevice" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="IsPermanent" class="form-check-input" />
                <label asp-for="IsPermanent" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="CanReissue" class="form-check-input" />
                <label asp-for="CanReissue" class="form-check-label"></label>
            </div>
            <div class="form-check">
                <input asp-for="CanRenew" class="form-check-input" />
                <label asp-for="CanRenew" class="form-check-label"></label>
            </div>
        </div>

        <div class="action-bar">
            <button type="submit" class="btn btn-dark">建立 Token</button>
            <a class="btn btn-outline-secondary" asp-action="Index">回到清單</a>
        </div>
    </form>
</section>

@if (Model.CreatedToken is not null)
{
    <section class="surface-card">
        <h3>建立結果</h3>
        <div class="summary-grid">
            <div class="summary-tile">
                <div class="summary-tile__title">TokenId</div>
                <div class="summary-tile__value"><code>@Model.CreatedToken.TokenId</code></div>
            </div>
            <div class="summary-tile">
                <div class="summary-tile__title">JwtId</div>
                <div class="summary-tile__value"><code>@Model.CreatedToken.JwtId</code></div>
            </div>
            <div class="summary-tile">
                <div class="summary-tile__title">Scope</div>
                <div class="summary-tile__value">@Model.CreatedToken.Scope</div>
            </div>
        </div>
        <div class="mt-3">
            <div class="muted-text mb-2">AccessToken</div>
            <div class="token-box">@Model.CreatedToken.AccessToken</div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
