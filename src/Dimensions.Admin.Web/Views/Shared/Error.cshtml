@model ErrorViewModel
@{
    ViewData["Title"] = "系統錯誤";
}

<section class="surface-card">
    <h2>系統錯誤</h2>
    <p class="muted-text">Admin Web 發生未預期的錯誤，請先查看畫面上的錯誤訊息與 caseId，再回頭檢查 Admin.Api 的 request / exception log。</p>
    @if (!string.IsNullOrWhiteSpace(Model.RequestId))
    {
        <div class="case-chip">RequestId: @Model.RequestId</div>
    }
</section>
