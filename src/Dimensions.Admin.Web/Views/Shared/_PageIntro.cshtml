@model PageIntroModel

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div>
        <h2>@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="muted-text">@Model.Description</div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
    {
        <a class="btn btn-dark" href="@Model.ActionUrl">@Model.ActionText</a>
    }
</div>
