@model DeviceCreatePageModel

<section class="surface-card">
    <h2>建立 Device</h2>
    <p class="muted-text">先建立可辨識的裝置資料，方便後續與 token 管理流程搭配使用。</p>

    @if (!string.IsNullOrWhiteSpace(Model.ResultMessage))
    {
        <div class="alert alert-success">@Model.ResultMessage</div>
    }

    <partial name="_ErrorAlert" model='new ErrorAlertModel { Title = "建立 Device 失敗", ErrorMessage = Model.ErrorMessage, ErrorCode = Model.ErrorCode, CaseId = Model.CaseId }' />

    <form asp-action="Create" method="post" class="d-flex flex-column gap-3 js-loading-form">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div>
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
            </div>
            <div>
                <label asp-for="DeviceId" class="form-label"></label>
                <input asp-for="DeviceId" class="form-control" />
            </div>
            <div>
                <label asp-for="DeviceName" class="form-label"></label>
                <input asp-for="DeviceName" class="form-control" />
            </div>
            <div>
                <label asp-for="DeviceType" class="form-label"></label>
                <input asp-for="DeviceType" class="form-control" />
            </div>
        </div>
        <div>
            <label asp-for="Remark" class="form-label"></label>
            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
        </div>
        <div class="action-bar">
            <button type="submit" class="btn btn-dark">建立 Device</button>
            <a class="btn btn-outline-secondary" asp-action="Index">回到清單</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
