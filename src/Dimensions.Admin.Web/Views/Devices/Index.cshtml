@model DeviceIndexPageModel

<partial name="_SearchPanel" model='new SearchPanelModel
{
    Title = "Device 清單",
    Description = "查詢已註冊的裝置，並可直接停用不再使用的 device。",
    FieldsPartialName = "Devices/_DeviceFilters",
    FieldsModel = Model,
    ResetUrl = Url.Action("Index"),
    SubmitText = "查詢"
}' />

@if (!string.IsNullOrWhiteSpace(Model.ResultMessage))
{
    <div class="alert alert-info">@Model.ResultMessage</div>
}

<partial name="_ErrorAlert" model='new ErrorAlertModel { Title = "查詢 Device 失敗", ErrorMessage = Model.ErrorMessage, ErrorCode = Model.ErrorCode, CaseId = Model.CaseId }' />

<div class="action-bar">
    <a class="btn btn-dark" asp-action="Create">建立 Device</a>
</div>

<partial name="_DataTable" model='new DataTableModel
{
    HasItems = Model.Result?.Items?.Any() == true,
    TablePartialName = "Devices/_DeviceTable",
    TableModel = Model,
    EmptyMessage = "目前查無符合條件的 device。"
}' />
